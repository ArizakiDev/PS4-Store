# Copiez ce fichier en « .env » à côté de server.js, puis renseignez les valeurs.

# --- Connexion Discord (https://discord.com/developers/applications > OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Adresse de redirection à déclarer dans OAuth2 > Redirects, ex. https://votre-site.tld/auth/discord/callback
DISCORD_REDIRECT_URI=

# Secret partagé avec le bot Discord (identique à BOT_API_SECRET de discord-bot/.env, 8 caractères minimum, aléatoire)
BOT_API_SECRET=

# Compte Discord (ID) promu super-administrateur au démarrage
ADMIN_DISCORD_ID=

# --- Optionnel ---
PORT=3000
# Adresse publique du site (liens dans les notifications)
PUBLIC_URL=
# Secret de session (généré automatiquement dans .session-secret si vide)
SESSION_SECRET=
# Webhook Discord des notifications d'ajout et rôle pingé (sinon réglables depuis l'espace créateur)
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=
DISCORD_INVITE_URL=
# Aide automatique (Ollama)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=
