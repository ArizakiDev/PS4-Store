<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head', { title: t('account.title') + ' — PS4Store', noindex: true }) %>
</head>
<body class="page-account">
  <%- include('partials/nav', { active: 'account' }) %>
  <%
    var shownName = profileForm.display_name || user.username;
    var pendingN = submissions.filter(function (s) { return s.status === 'pending'; }).length;
    var approvedN = submissions.filter(function (s) { return s.status === 'approved'; }).length;
  %>
  <main class="wrap acct">
    <div class="acct-grid">

      <aside class="acct-card acct-profile glass" id="profile">
        <span class="acct-avatar" id="avatar-box"><% if (profile.avatar) { %><img src="<%= profile.avatar %>" alt="" width="96" height="96"><% } else { %><span><%= initials(shownName) %></span><% } %></span>
        <h1 class="acct-name"><%= shownName %></h1>
        <p class="acct-handle">@<%= user.username %><% if (user.discord) { %> · <%= user.discord %><% } %></p>
        <div class="acct-badges">
          <span class="role-badge role-<%= user.role === 'user' ? 'member' : user.role %>"><%= t('role.' + (user.role === 'user' ? 'member' : user.role)) %></span>
          <%- include('partials/badges', { list: user.badges }) %>
        </div>
        <% if (profileForm.bio) { %><p class="acct-bio"><%= profileForm.bio %></p><% } %>
        <% if (profileForm.youtube || profileForm.github || profileForm.twitter) { %>
          <div class="acct-socials">
            <% if (profileForm.youtube) { %><a class="acct-social" href="<%= profileForm.youtube %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="YouTube" title="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor"/></svg></a><% } %>
            <% if (profileForm.github) { %><a class="acct-social" href="<%= profileForm.github %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 6.5l-3 11"/></svg></a><% } %>
            <% if (profileForm.twitter) { %><a class="acct-social" href="<%= profileForm.twitter %>" target="_blank" rel="noopener noreferrer nofollow" aria-label="X / Twitter" title="X / Twitter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg></a><% } %>
          </div>
        <% } %>
        <div class="acct-actions">
          <button class="btn" type="button" id="open-edit"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 16 1-4 8.5-8.5a1.8 1.8 0 0 1 2.5 2.5L7.5 14.5 4 16z"/></svg><%= t('acc2.edit_short') %></button>
          <a class="btn ghost" href="/membre/<%= encodeURIComponent(user.username) %>"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="7" r="3.2"/><path d="M3.8 16.5c.7-3 3.2-4.5 6.2-4.5s5.5 1.5 6.2 4.5"/></svg><%= t('acc2.view_short') %></a>
          <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn danger-soft" type="submit"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M8 4H5.5A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8M12 6.5 15.5 10 12 13.5M15.5 10H8"/></svg><%= t('account.logout') %></button></form>
        </div>
        <p class="acct-since"><%= t('account.member_since', { date: fmtDate(user.created_at) }) %></p>
      </aside>

      <div class="acct-main">

        <section class="acct-card glass" id="console-card">
          <div id="console-live" aria-live="polite"><% if (!consoles.length) { %><div class="acct-head"><h2><%= t('acc.console.title') %></h2><button class="btn ghost small" type="button" data-open-pair><%= t('acc2.link_console') %></button></div><p class="acct-empty"><%= t('acc.console.none') %></p><% } %></div>
        </section>

        <section class="acct-card acct-props glass" id="submissions">
          <div class="acct-props-main">
            <h2><%= t('account.subs.title') %></h2>
            <p><%= submissions.length ? t('acc2.props_counts', { pending: pendingN, approved: approvedN }) : t('acc2.props_none') %></p>
          </div>
          <a class="btn small" href="/proposer"><%= t('acc2.propose') %></a>
          <% if (submissions.length) { %>
            <details class="acct-props-list">
              <summary><%= t('acc2.props_show', { n: submissions.length }) %></summary>
              <ul class="sub-list">
                <% submissions.forEach(function (s) { %>
                  <li>
                    <span class="status-pill <%= s.status %>"><%= t('account.subs.' + s.status) %></span>
                    <strong><%= s.titre %></strong>
                    <span class="hint">v<%= s.version %> · <%= t('type.' + s.type) %> · <%= fmtDate(s.created_at) %></span>
                    <% if (s.status === 'approved' && s.game_id) { %><a class="hint" style="color:var(--accent-text)" href="/jeu/<%= s.game_id %>"><%= t('account.subs.view') %></a><% } %>
                    <% if (s.status === 'rejected') { %><span class="sub-reason"><%= t('account.subs.reason', { reason: s.reason }) %></span><% } %>
                  </li>
                <% }) %>
              </ul>
            </details>
          <% } %>
        </section>

        <section class="acct-lib" id="bibliotheque">
          <h2><%= t('account.library') %> <span class="pill"><%= library.length %></span></h2>
          <% if (!library.length) { %><p class="acct-empty"><%= t('account.library.empty') %></p><% } else { %>
            <div class="lib-grid">
              <% library.forEach(function (g) { %>
                <article class="lib-card glass" data-id="<%= g.id %>">
                  <a class="lib-cover" href="/jeu/<%= g.id %>" aria-label="<%= g.titre %>"><img src="<%= g.icon_url %>" alt="" width="185" height="185" loading="lazy" decoding="async"></a>
                  <div class="lib-body">
                    <a class="lib-title" href="/jeu/<%= g.id %>" title="<%= g.titre %>"><%= g.titre %></a>
                    <div class="lib-btns">
                      <button type="button" class="btn small" data-send="<%= g.id %>"><%= t('acc2.send_ps4') %></button>
                      <button type="button" class="btn ghost small icon-only" data-remove="<%= g.id %>" aria-label="<%= t('acc2.remove') %>" title="<%= t('acc2.remove') %>"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 6h11M8 6V4.5h4V6M6 6l.6 9.5h6.8L14 6M8.5 9v4M11.5 9v4"/></svg></button>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </section>

        <% if (liked.length) { %>
        <section class="acct-lib">
          <h2><%= t('account.likes') %> <span class="pill"><%= liked.length %></span></h2>
          <div class="lib-grid">
            <% liked.forEach(function (g) { %>
              <article class="lib-card glass">
                <a class="lib-cover" href="/jeu/<%= g.id %>" aria-label="<%= g.titre %>"><img src="<%= g.icon_url %>" alt="" width="185" height="185" loading="lazy" decoding="async"></a>
                <div class="lib-body"><a class="lib-title" href="/jeu/<%= g.id %>" title="<%= g.titre %>"><%= g.titre %></a></div>
              </article>
            <% }) %>
          </div>
        </section>
        <% } %>
      </div>
    </div>
  </main>

  <dialog class="acct-modal" id="edit-modal" aria-labelledby="edit-title">
    <form method="dialog" class="acct-x"><button class="btn ghost small" aria-label="<%= t('common.close') %>">&times;</button></form>
    <h2 id="edit-title"><%= t('acc2.edit_profile') %></h2>

    <div class="acct-avatar-edit">
      <span class="acct-avatar small"><% if (profile.avatar) { %><img src="<%= profile.avatar %>" alt="" width="64" height="64"><% } else { %><span><%= initials(shownName) %></span><% } %></span>
      <input type="file" id="avatar-file" accept="image/png,image/jpeg,image/webp" hidden>
      <div class="acct-row">
        <button class="btn small" type="button" id="avatar-pick"><%= t('acc.avatar.change') %></button>
        <% if (profile.discord && profile.discord.avatar) { %><button class="btn ghost small" type="button" id="avatar-discord"><%= t('acc.avatar.discord') %></button><% } %>
        <% if (profile.avatar) { %><button class="btn ghost small" type="button" id="avatar-del"><%= t('acc.avatar.delete') %></button><% } %>
      </div>
    </div>
    <p class="acct-msg" id="avatar-status" role="status" aria-live="polite"></p>

    <form class="acct-form" method="post" action="/mon-compte/profile" autocomplete="off">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field"><%= t('acc.profile.display_name') %><input class="input" name="display_name" value="<%= profileForm.display_name %>" maxlength="60" placeholder="<%= user.username %>"></label>
      <label class="field"><%= t('acc.profile.bio') %><textarea class="input" name="bio" maxlength="280" rows="3"><%= profileForm.bio %></textarea></label>
      <div class="acct-two">
        <label class="field"><%= t('acc.profile.discord_tag') %><input class="input" name="discord_tag" value="<%= profileForm.discord_tag %>" maxlength="40"></label>
        <label class="field"><%= t('acc.profile.youtube') %><input class="input" type="url" name="youtube" value="<%= profileForm.youtube %>" maxlength="300" placeholder="https://youtube.com/@…"></label>
        <label class="field"><%= t('acc.profile.github') %><input class="input" type="url" name="github" value="<%= profileForm.github %>" maxlength="300" placeholder="https://github.com/…"></label>
        <label class="field"><%= t('acc.profile.twitter') %><input class="input" type="url" name="twitter" value="<%= profileForm.twitter %>" maxlength="300" placeholder="https://x.com/…"></label>
      </div>
      <fieldset class="acct-privacy">
        <legend><%= t('acc2.privacy') %></legend>
        <label class="check"><input type="checkbox" name="public_library" value="1"<%= profileForm.public_library ? ' checked' : '' %>><span><%= t('acc.profile.public_library') %></span></label>
        <label class="check"><input type="checkbox" name="public_activity" value="1"<%= profileForm.public_activity ? ' checked' : '' %>><span><%= t('acc.profile.public_activity') %></span></label>
      </fieldset>
      <details class="acct-rpc">
        <summary><%= t('acc.rpc.title') %></summary>
        <div class="acct-row"><code class="token" id="rpc-token"><%= profile.rpcToken %></code><button class="btn ghost small" type="button" id="rpc-copy"><%= t('acc.rpc.copy') %></button></div>
        <p class="hint"><%= t('acc.rpc.hint') %></p>
      </details>
      <div class="acct-foot"><button class="btn ghost" type="button" data-close><%= t('common.cancel') %></button><button class="btn" type="submit"><%= t('acc.profile.save') %></button></div>
    </form>
  </dialog>

  <dialog class="acct-modal narrow" id="pair-modal" aria-labelledby="pair-title">
    <form method="dialog" class="acct-x"><button class="btn ghost small" aria-label="<%= t('common.close') %>">&times;</button></form>
    <h2 id="pair-title"><%= t('acc2.pair.title') %></h2>
    <p class="hint"><%= t('account.pair.hint') %></p>
    <div class="pair-code" id="pair-code" aria-live="polite"><%= t('acc2.pair.idle') %></div>
    <p class="acct-msg" id="pair-info" role="status"></p>
    <div class="acct-foot"><button class="btn" type="button" id="pair-btn"><%= t('acc2.pair.generate') %></button></div>
  </dialog>

  <dialog class="acct-modal" id="inst-modal" aria-labelledby="inst-title">
    <form method="dialog" class="acct-x"><button class="btn ghost small" aria-label="<%= t('common.close') %>">&times;</button></form>
    <h2 id="inst-title"></h2>
    <div id="inst-body"></div>
  </dialog>

  <div class="acct-toast" id="toast" role="status" aria-live="polite" hidden></div>

  <%- include('partials/foot') %>
  <script type="application/json" id="library-data"><%- JSON.stringify(libraryList).replace(/</g, '\\u003c') %></script>
  <script>
    (function () {
      'use strict';
      var token = document.querySelector('meta[name="csrf-token"]').content;
      var L = <%- JSON.stringify({
        locale: lang, saved: t('acc.avatar.saved'), err: t('acc.avatar.error'), copied: t('acc.rpc.copied'), generic: t('common.error'),
        online: t('acc.console.online'), offline: t('acc.console.offline'), playing: t('acc.console.playing'), storage: t('acc.console.storage'),
        none: t('acc.console.installed.empty'), launch: t('acc.console.launch'), uninstall: t('acc.console.uninstall'),
        confirmUn: t('acc.console.confirm_uninstall'), fromLib: t('acc.console.install_from_library'), install: t('acc.console.install'),
        lastActivity: t('acc.console.last_activity'), never: t('account.console.never_seen'), unlink: t('account.console.unlink'),
        installedBtn: t('acc2.installed_btn'), installedTitle: t('acc2.installed_title'), sentCmd: t('acc.console.sent'),
        toastSent: t('acc2.toast.sent'), toastRemoved: t('acc2.toast.removed'), toastSaved: t('acc.profile.ok'), noConsole: t('acc2.no_console'),
        expires: t('account.pair.expires'), expired: t('account.pair.expired'), done: t('account.pair.done'), noConsoleHint: t('acc.console.none'), consoleTitle: t('acc.console.title'), linkConsole: t('acc2.link_console')
      }) %>;
      var $ = function (id) { return document.getElementById(id); };
      function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function post(url, body) {
        var isBlob = body && body.constructor === Blob;
        return fetch(url, { method: 'POST', credentials: 'same-origin', headers: Object.assign({ 'X-CSRF-Token': token }, body && !isBlob ? { 'Content-Type': 'application/json' } : {}), body: body ? (isBlob ? body : JSON.stringify(body)) : undefined })
          .then(function (r) { return r.json().catch(function () { return {}; }).then(function (d) { return { ok: r.ok, data: d }; }); });
      }
      function when(iso) { if (!iso) return L.never; try { return new Date(iso).toLocaleString(L.locale, { dateStyle: 'medium', timeStyle: 'short' }); } catch (e) { return iso; } }
      function gb(b) { return (b / 1073741824).toFixed(1); }

      var toast = $('toast'), toastT = null;
      function showToast(msg, bad) {
        toast.textContent = msg; toast.className = 'acct-toast' + (bad ? ' is-bad' : ''); toast.hidden = false;
        void toast.offsetWidth; toast.classList.add('is-on');
        clearTimeout(toastT); toastT = setTimeout(function () { toast.classList.remove('is-on'); setTimeout(function () { toast.hidden = true; }, 300); }, bad ? 6000 : 4500);
      }
      function openDlg(d) { if (d.showModal) d.showModal(); else d.setAttribute('open', ''); }
      document.querySelectorAll('.acct-modal').forEach(function (d) {
        d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
        d.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', function () { d.close(); }); });
      });

      $('open-edit').addEventListener('click', function () { openDlg($('edit-modal')); });
      var qs = new URLSearchParams(location.search);
      if (qs.get('edit') === '1') { openDlg($('edit-modal')); history.replaceState(null, '', location.pathname); }
      else if (qs.get('profile') === 'ok') { showToast(L.toastSaved); history.replaceState(null, '', location.pathname); }
      else if (qs.get('profile') === 'error') { openDlg($('edit-modal')); history.replaceState(null, '', location.pathname); }
      var fileIn = $('avatar-file'), st = $('avatar-status');
      $('avatar-pick').addEventListener('click', function () { fileIn.click(); });
      fileIn.addEventListener('change', function () {
        var f = fileIn.files[0]; if (!f) return;
        var img = new Image(), url = URL.createObjectURL(f);
        img.onload = function () {
          var c = document.createElement('canvas'); c.width = c.height = 256; var g = c.getContext('2d');
          var side = Math.min(img.width, img.height);
          g.drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, 256, 256);
          URL.revokeObjectURL(url);
          c.toBlob(function (blob) { post('/mon-compte/avatar', blob).then(function (r) { st.textContent = r.ok ? L.saved : (r.data.erreur || L.err); if (r.ok) setTimeout(function () { location.reload(); }, 600); }); }, 'image/png');
        };
        img.onerror = function () { st.textContent = L.err; };
        img.src = url;
      });
      var dis = $('avatar-discord');
      if (dis) dis.addEventListener('click', function () { post('/mon-compte/avatar/discord', {}).then(function (r) { st.textContent = r.ok ? L.saved : (r.data.erreur || L.err); if (r.ok) setTimeout(function () { location.reload(); }, 600); }); });
      var del = $('avatar-del');
      if (del) del.addEventListener('click', function () { post('/mon-compte/avatar/delete', {}).then(function () { location.reload(); }); });
      $('rpc-copy').addEventListener('click', function () { var b = this; try { navigator.clipboard.writeText($('rpc-token').textContent); var o = b.textContent; b.textContent = L.copied; setTimeout(function () { b.textContent = o; }, 1800); } catch (e) {} });

      var lib = $('bibliotheque');
      if (lib) lib.addEventListener('click', function (e) {
        var s = e.target.closest('[data-send]'), r = e.target.closest('[data-remove]');
        if (s) {
          s.disabled = true;
          post('/api/remote-download/' + s.dataset.send).then(function (res) { showToast(res.ok ? L.toastSent : (res.data.erreur || L.generic), !res.ok); }).catch(function () { showToast(L.generic, true); }).then(function () { s.disabled = false; });
        } else if (r) {
          r.disabled = true;
          post('/api/games/' + r.dataset.remove + '/library').then(function (res) {
            if (!res.ok) { r.disabled = false; showToast(res.data.erreur || L.generic, true); return; }
            var card = r.closest('.lib-card'); if (card) card.remove();
            showToast(L.toastRemoved);
            if (!lib.querySelector('.lib-card')) location.reload();
          }).catch(function () { r.disabled = false; showToast(L.generic, true); });
        }
      });

      var pairBtn = $('pair-btn'), box = $('pair-code'), info = $('pair-info');
      var consolesAtStart = <%= consoles.length %>, endAt = 0, tick = null, poll = null;
      function fmt(sec) { var m = Math.floor(sec / 60), s = sec % 60; return m + ':' + (s < 10 ? '0' : '') + s; }
      function stopPair() { clearInterval(tick); clearInterval(poll); }
      $('pair-modal').addEventListener('close', stopPair);
      pairBtn.addEventListener('click', function () {
        pairBtn.disabled = true;
        post('/api/pair/generate', {}).then(function (r) {
          pairBtn.disabled = false;
          var d = r.data; if (!d.code) { info.textContent = d.erreur || L.generic; return; }
          box.textContent = d.code; box.classList.remove('is-expired'); box.classList.add('has-code');
          endAt = Date.now() + d.expires_in * 1000; stopPair();
          tick = setInterval(function () {
            var left = Math.max(0, Math.round((endAt - Date.now()) / 1000));
            info.textContent = left ? L.expires.replace('{time}', fmt(left)) : L.expired;
            if (!left) { stopPair(); box.classList.add('is-expired'); }
          }, 500);
          poll = setInterval(function () {
            fetch('/api/pair/status', { credentials: 'same-origin' }).then(function (x) { return x.json(); }).then(function (s) {
              if (s.consoles > consolesAtStart) { stopPair(); info.textContent = L.done; setTimeout(function () { location.reload(); }, 900); }
            }).catch(function () {});
          }, 2000);
        }).catch(function () { pairBtn.disabled = false; });
      });

      var live = $('console-live'), library = JSON.parse($('library-data').textContent), lastData = { consoles: [] }, openInst = '';
      function renderInstalled(c) {
        $('inst-title').textContent = L.installedTitle.replace('{name}', c.name);
        $('inst-body').innerHTML = c.installed.length ? '<ul class="inst-list">' + c.installed.map(function (g) {
          return '<li><div><strong>' + esc(g.name || g.title_id) + '</strong> <span class="hint">' + esc(g.title_id) + (g.version ? ' · v' + esc(g.version) : '') + (g.size ? ' · ' + esc(g.size) : '') + '</span></div><div class="acct-row">' +
            '<button class="btn small" data-cmd="launch" data-console="' + esc(c.id) + '" data-title="' + esc(g.title_id) + '" data-name="' + esc(g.name) + '">' + esc(L.launch) + '</button>' +
            (g.title_id === 'PSTR00001' ? '' : '<button class="btn danger small" data-cmd="uninstall" data-console="' + esc(c.id) + '" data-title="' + esc(g.title_id) + '" data-name="' + esc(g.name) + '">' + esc(L.uninstall) + '</button>') + '</div></li>';
        }).join('') + '</ul>' : '<p class="acct-empty">' + esc(L.none) + '</p>';
      }
      function render(data) {
        lastData = data;
        if (!data.consoles.length) { live.innerHTML = '<div class="acct-head"><h2>' + esc(L.consoleTitle) + '</h2><button class="btn ghost small" type="button" data-open-pair>' + esc(L.linkConsole) + '</button></div><p class="acct-empty">' + esc(L.noConsoleHint) + '</p>'; return; }
        live.innerHTML = data.consoles.map(function (c, idx) {
          var kind = c.playing ? 'play' : c.online ? 'on' : 'off';
          var label = c.playing ? L.playing.replace('{name}', c.playing.name || c.playing.title_id) : (c.online ? L.online : L.offline);
          var used = c.disk_total ? Math.max(0, Math.min(100, Math.round((c.disk_total - c.disk_free) / c.disk_total * 100))) : 0;
          var disk = c.disk_total ? '<div class="gauge"><span style="width:' + used + '%"></span></div><div class="hint">' + esc(L.storage.replace('{free}', gb(c.disk_free)).replace('{total}', gb(c.disk_total))) + '</div>' : '';
          var opts = library.map(function (g) { return '<option value="' + esc(g.id) + '">' + esc(g.titre) + '</option>'; }).join('');
          var head = '<div class="acct-ctop"><div class="acct-cname"><strong>' + esc(c.name) + '</strong><span class="badge-state ' + kind + '">' + esc(label) + '</span></div>' +
            '<div class="acct-cmeta"><span class="hint">' + esc(L.lastActivity.replace('{date}', when(c.last_seen))) + (c.app_version ? ' · v' + esc(c.app_version) : '') + '</span>' +
            (idx === 0 ? '<button class="btn ghost small" type="button" data-open-pair>' + esc(L.linkConsole) + '</button>' : '') + '</div></div>';
          var row1 = library.length ? '<div class="acct-install"><select class="input sel" id="lib-' + esc(c.id) + '"><option value="">' + esc(L.fromLib) + '</option>' + opts + '</select><button class="btn small" data-cmd="install" data-console="' + esc(c.id) + '">' + esc(L.install) + '</button></div>' : '';
          var tools = '<div class="acct-tools"><button class="btn ghost small" type="button" data-installed="' + esc(c.id) + '">📦 ' + esc(L.installedBtn.replace('{n}', c.installed.length)) + '</button>' +
            '<form method="post" action="/mon-compte/consoles/' + encodeURIComponent(c.id) + '/delete" class="acct-unlink"><input type="hidden" name="_csrf" value="' + esc(token) + '"><button class="btn link" type="submit">' + esc(L.unlink) + '</button></form></div>';
          return '<div class="console-tile">' + head + disk + row1 + tools + '</div>';
        }).join('');
        if (openInst) { var oc = data.consoles.filter(function (x) { return x.id === openInst; })[0]; if (oc) renderInstalled(oc); }
      }
      function refresh() { fetch('/api/me/console-status', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(render).catch(function () {}); }
      function onCmd(e) {
        var b = e.target.closest('[data-cmd]'); if (!b) return;
        var cmd = b.getAttribute('data-cmd'), body = { action: cmd, console_id: b.getAttribute('data-console') };
        if (cmd === 'install') { var sel = $('lib-' + body.console_id); if (!sel || !sel.value) return; body.game_id = sel.value; }
        else { body.title_id = b.getAttribute('data-title'); body.name = b.getAttribute('data-name'); if (cmd === 'uninstall' && !confirm(L.confirmUn.replace('{name}', body.name || body.title_id))) return; }
        b.disabled = true;
        post('/api/me/remote-command', body).then(function (r) {
          showToast(r.ok ? (cmd === 'install' ? L.toastSent : L.sentCmd) : (r.data.erreur || L.generic), !r.ok);
          setTimeout(function () { b.disabled = false; refresh(); }, 1500);
        });
      }
      live.addEventListener('click', function (e) {
        if (e.target.closest('[data-open-pair]')) { openDlg($('pair-modal')); return; }
        var i = e.target.closest('[data-installed]');
        if (i) { var c = lastData.consoles.filter(function (x) { return x.id === i.dataset.installed; })[0]; if (c) { openInst = c.id; renderInstalled(c); openDlg($('inst-modal')); } return; }
        onCmd(e);
      });
      $('inst-body').addEventListener('click', onCmd);
      $('inst-modal').addEventListener('close', function () { openInst = ''; });
      refresh(); setInterval(refresh, 5000);
      PS4.reveal(document.querySelectorAll('.card.reveal'));
    })();
  </script>
</body>
</html>
