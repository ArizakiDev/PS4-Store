<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('partials/head', { title: t('home.title'), description: t('home.desc') }) %>
</head>
<body class="page-index">

  <%- include('partials/nav', { active: 'home' }) %>
  <%
    var verLabel = release ? release.version : stats.version;
    var sizeLabel = release && release.size_label ? release.size_label : (storePkg.available ? storePkg.size : '');
    var hasNotes = !!(release && (release.changelog || release.history.length));
    var tiles = latest.slice(0, 3);
  %>

  <main>
    <section class="hero">
      <div class="hero-grid<%= isHidden('hero_client_card') ? ' hero-solo' : '' %>">
        <div class="hero-left">
          <% if (!isHidden('hero_status_pill')) { %>          <span class="pill status-pill"<%- tg('hero_status_pill') %> id="api-status" data-online="<%= t('home.api.online') %>" data-offline="<%= t('home.api.offline') %>" data-suffix=" · <%= t('home.status.range') %>"><span class="dot-off"></span> <span class="st-label"><%= t('home.api.online') %></span> · <%= t('home.status.range') %></span><% } %>
          <h1><%= t('home.h1a') %> <%= t('home.h1b') %></h1>
          <% if (!isHidden('hero_subtitle')) { %><p class="hero-sub"<%- tg('hero_subtitle') %>><%= t('home.sub') %></p><% } %>

          <div class="hero-actions">
            <% if (!isHidden('hero_download_btn')) { %><span class="tg-wrap"<%- tg('hero_download_btn') %>>
            <% if (storePkg.available) { %>
              <a class="btn hero-dl" href="/store/PS4Store.pkg" download="PS4Store.pkg">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18"><path d="M8 2v8.5M4.5 7.5 8 11l3.5-3.5M3 13.5h10"/></svg>
                <span class="hero-dl-txt"><strong><%= t('home.download') %></strong><small>v<%= verLabel %><% if (sizeLabel) { %> · <%= sizeLabel %><% } %></small></span>
              </a>
            <% } else { %>
              <span class="btn hero-dl" role="link" aria-disabled="true"><span class="hero-dl-txt"><strong><%= t('home.download') %></strong><small><%= t('home.pkg.missing') %></small></span></span>
            <% } %>
            </span><% } %>
            <% if (!isHidden('hero_explore_btn')) { %><a class="btn ghost" href="/catalogue"<%- tg('hero_explore_btn') %>><%= t('home.cta.explore') %></a><% } %>
            <% if (hasNotes && !isHidden('hero_changelog_btn')) { %><button type="button" class="hero-notes" id="notes-open"<%- tg('hero_changelog_btn') %>><%= t('home.notes.link') %></button><% } %>
          </div>
        </div>

        <% if (!isHidden('hero_client_card')) { %>
        <aside class="showcase glass" aria-label="PS4Store Client"<%- tg('hero_client_card') %>>
          <div class="sc-top">
            <span class="sc-title"><span class="brand-mark" aria-hidden="true"></span>PS4Store Client</span>
            <span class="pill accent">v<%= verLabel %></span>
          </div>
          <% if (!isHidden('hero_client_screen')) { %><div class="sc-screen" aria-hidden="true"<%- tg('hero_client_screen') %>>
            <div class="sc-tabs"><span class="on"></span><span></span><span></span><span></span></div>
            <div class="sc-tiles">
              <% for (var i = 0; i < 3; i++) { var tile = tiles[i]; %>
                <span class="sc-tile"><% if (tile) { %><img src="<%= tile.icon_url %>" alt="" width="120" height="120" loading="lazy"><% } %></span>
              <% } %>
            </div>
            <div class="sc-bar"><span></span></div>
          </div><% } %>
          <% if (!isHidden('hero_client_features')) { %><ul class="sc-feats"<%- tg('hero_client_features') %>>
            <li><span class="sc-ic"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9.5M6 9l4 4 4-4M4 16.5h12"/></svg></span><div><strong><%= t('home.feat1.t') %></strong><span><%= t('home.feat1.d') %></span></div></li>
            <li><span class="sc-ic"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 7h12M4 13h12M7 4v12M13 4v12"/></svg></span><div><strong><%= t('home.feat2.t') %></strong><span><%= t('home.feat2.d') %></span></div></li>
            <li><span class="sc-ic"><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="4" width="14" height="10" rx="2"/><path d="M7 17h6M10 14v3"/></svg></span><div><strong><%= t('home.feat3.t') %></strong><span><%= t('home.feat3.d') %></span></div></li>
          </ul><% } %>
          <% if (!isHidden('hero_client_status')) { %><div class="sc-state"<%- tg('hero_client_status') %>><span class="dot-off" id="sc-dot"></span><span id="sc-state-txt"><%= t('home.api.online') %></span></div><% } %>
        </aside>
        <% } %>
      </div>

      <% if (!isHidden('hero_stats_bar')) { %><div class="stats-wrap"<%- tg('hero_stats_bar') %>>
        <div class="statbar glass">
          <div class="sb"><span class="sb-v accent"><%= stats.total %></span><span class="sb-k"><%= t('home.sb.resources') %></span></div>
          <div class="sb"><span class="sb-v">v<%= verLabel %></span><span class="sb-k"><%= t('home.sb.version') %></span></div>
          <div class="sb"><span class="sb-v"><%= stats.contributors %></span><span class="sb-k"><%= t('home.sb.creators') %></span></div>
          <div class="sb"><span class="sb-v small">5.05 → 11.00</span><span class="sb-k"><%= t('home.sb.firmware') %></span></div>
        </div>
      </div><% } %>
    </section>

    <% if (isPreview) { %><div class="preview-flag">Aperçu non publié</div><% } %>
    <%- include('partials/vitrine', { vitrine: vitrine }) %>

    <% if (collections.length && !isHidden('home_collections')) { %><div class="wrap home-collections"<%- tg('home_collections') %>><%- include('partials/collections', { collections: collections, mode: 'link' }) %></div><% } %>

    <% if (!isHidden('home_install_steps')) { %><section class="section" id="installation" style="padding-top:0"<%- tg('home_install_steps') %>>
      <div class="wrap">
        <div class="section-head"><h2><%= t('home.install.title') %></h2></div>
        <div class="steps">
          <div class="step glass"><span class="step-num">1</span><h3><%= t('home.step1.t') %></h3><p><%= t('home.step1.d') %></p></div>
          <div class="step glass"><span class="step-num">2</span><h3><%= t('home.step2.t') %></h3><p><%= t('home.step2.d') %></p></div>
          <div class="step glass"><span class="step-num">3</span><h3><%= t('home.step3.t') %></h3><p><%= t('home.step3.d') %></p></div>
        </div>
      </div>
    </section><% } %>

    <% if (!isHidden('home_cta')) { %><section class="section home-cta-sec"<%- tg('home_cta') %>>
      <div class="wrap">
        <div class="home-cta glass">
          <div><h2><%= t('home.cta.title') %></h2><p><%= t('home.cta.text') %></p></div>
          <div class="home-cta-btns">
            <% if (discordInvite) { %><a class="btn discord" href="<%= discordInvite %>" target="_blank" rel="noopener noreferrer"><%= t('home.cta.discord') %></a><% } %>
            <a class="btn<%= discordInvite ? ' ghost' : '' %>" href="/proposer"><%= t('home.cta.propose') %></a>
          </div>
        </div>
      </div>
    </section><% } %>
  </main>

  <% if (hasNotes) { %>
  <dialog class="home-modal" id="notes-modal" aria-labelledby="notes-title">
    <form method="dialog" class="hm-x"><button class="btn ghost small" aria-label="<%= t('common.close') %>">&times;</button></form>
    <h2 id="notes-title"><%= t('home.release.history') %></h2>
    <ol class="hm-list">
      <li>
        <span class="pill accent">v<%= release.version %></span>
        <div><div class="rh-date"><%= fmtDate(release.updated_at) %><% if (release.size_label) { %> · <%= release.size_label %><% } %></div><p><%= release.changelog %></p></div>
      </li>
      <% release.history.forEach(function (h) { %>
        <li>
          <span class="pill">v<%= h.version %></span>
          <div>
            <div class="rh-date"><%= h.updated_at ? fmtDate(h.updated_at) : '' %><% if (h.size_label) { %> · <%= h.size_label %><% } %><% if (h.pkg_url) { %> · <a href="<%= h.pkg_url %>" download><%= t('home.release.download_old') %></a><% } %></div>
            <p><%= h.changelog %></p>
          </div>
        </li>
      <% }) %>
    </ol>
  </dialog>
  <% } %>

  <%- include('partials/foot') %>
  <script>
    (function () {
      PS4.reveal(document.querySelectorAll('.card.reveal'));

      var nm = document.getElementById('notes-modal'), no = document.getElementById('notes-open');
      if (nm && no) {
        no.addEventListener('click', function () { if (nm.showModal) nm.showModal(); else nm.setAttribute('open', ''); });
        nm.addEventListener('click', function (e) { if (e.target === nm) nm.close(); });
      }

      var el = document.getElementById('api-status'), lab = el && el.querySelector('.st-label'), dot = document.getElementById('sc-dot'), st = document.getElementById('sc-state-txt');
      var ONLINE = <%- JSON.stringify(t('home.api.online')) %>, OFFLINE = <%- JSON.stringify(t('home.api.offline')) %>;
      function set(ok) {
        if (el) { el.firstElementChild.className = ok ? 'dot-ok' : 'dot-off'; lab.textContent = ok ? ONLINE : OFFLINE; }
        if (dot) dot.className = ok ? 'dot-ok' : 'dot-off';
        if (st) st.textContent = ok ? ONLINE : OFFLINE;
      }
      if (!el && !dot && !st) return;
      fetch('/api/games', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function () { set(true); })
        .catch(function () { set(false); });
    })();
  </script>
</body>
</html>
