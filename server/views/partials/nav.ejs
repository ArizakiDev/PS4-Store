<%
  var navActive = typeof active !== 'undefined' ? active : '';
  var navAdmin = typeof navAdminUser !== 'undefined' ? navAdminUser : null;
%>
<% if (typeof siteTheme !== 'undefined' && siteTheme && siteTheme.announce && siteTheme.announce.active && siteTheme.announce.text) { var an = siteTheme.announce; %>
<div class="site-announce" style="--ann: <%= an.color %>" role="note"><span data-site-announce><%= an.text %></span><% if (an.link_url && an.link_label) { %><a href="<%= an.link_url %>"<%- /^https?:/.test(an.link_url) ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= an.link_label %></a><% } %></div>
<% } %>
<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="brand nav-brand" href="/" aria-label="<%= t('nav.brand_label') %>"><span class="brand-mark" aria-hidden="true"></span><span class="brand-text">PS4Store</span><% if (navActive === 'admin') { %> <small>Admin</small><% } %></a>
    <nav class="nav-links" aria-label="<%= t('nav.label') %>">
      <a href="/"<%- navActive === 'home' ? ' aria-current="page"' : '' %>><%= t('nav.home') %></a>
      <a href="/catalogue"<%- navActive === 'catalogue' ? ' aria-current="page"' : '' %>><%= t('nav.catalogue') %></a>
      <a href="/demandes"<%- navActive === 'requests' ? ' aria-current="page"' : '' %>><%= t('nav.requests') %></a>
    </nav>
    <div class="nav-tools">
      <details class="menu" id="menu-lang">
        <summary aria-label="<%= t('nav.language') %>">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6.2"/><path d="M1.8 8h12.4M8 1.8c1.8 1.8 2.7 3.9 2.7 6.2S9.8 12.4 8 14.2C6.2 12.4 5.3 10.3 5.3 8S6.2 3.6 8 1.8Z"/></svg>
          <span class="menu-label"><%= lang.toUpperCase() %></span>
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 3.5 3 3 3-3"/></svg>
        </summary>
        <div class="menu-panel" role="menu" aria-label="<%= t('nav.language') %>">
          <% LANGS.forEach(function (code) { %>
            <a class="menu-item" role="menuitemradio" aria-checked="<%= code === lang %>" href="/lang/<%= code %>?next=<%= encodeURIComponent(currentPath) %>" hreflang="<%= code %>" lang="<%= code %>">
              <span class="menu-text"><%= langNames[code] %></span>
              <svg class="check" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 7.5 3 3 6-6.5"/></svg>
            </a>
          <% }) %>
        </div>
      </details>
      <details class="menu" id="menu-theme">
        <summary aria-label="<%= t('nav.theme') %>">
          <span class="swatch" data-theme-current data-t="oled"></span>
          <span class="menu-label" data-theme-label><%= t('theme.oled') %></span>
          <svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 3.5 3 3 3-3"/></svg>
        </summary>
        <div class="menu-panel" role="menu" aria-label="<%= t('nav.theme') %>">
          <% ['oled', 'classic', 'midnight', 'light'].forEach(function (th) { %>
            <button class="menu-item" type="button" role="menuitemradio" aria-checked="<%= th === 'oled' %>" data-theme-choice="<%= th %>">
              <span class="swatch" data-t="<%= th %>"></span>
              <span class="menu-text"><%= t('theme.' + th) %></span>
              <svg class="check" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 7.5 3 3 6-6.5"/></svg>
            </button>
          <% }) %>
        </div>
      </details>
      <% if (me) { %>
        <details class="menu profile-menu" id="menu-profile">
          <summary class="profile-block" aria-label="<%= t('nav.profile') %>">
            <span class="avatar nav-av" style="--size:36px;font-size:13px"><%= initials(me.username) %><% if (me.avatar) { %><img src="<%= me.avatar %>" alt="" width="36" height="36"><% } %></span>
            <span class="pinfo"><span class="pname"><%= me.username %></span><span class="role-badge mini role-<%= me.roleKey %>"><%= t('role.' + me.roleKey) %></span></span>
            <svg class="chev" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="12" height="12"><path d="m2 3.5 3 3 3-3"/></svg>
          </summary>
          <div class="menu-panel profile-panel" role="menu" aria-label="<%= t('nav.profile') %>">
            <a class="menu-item" role="menuitem" href="/membre/<%= encodeURIComponent(me.username) %>"><span class="menu-text"><%= t('nav.public_profile') %></span></a>
            <a class="menu-item" role="menuitem" href="/mon-compte"><span class="menu-text"><%= t('nav.account') %></span></a>
            <a class="menu-item" role="menuitem" href="/proposer"><span class="menu-text"><%= t('nav.submit') %></span></a>
            <% if (me.role === 'admin' || me.role === 'superadmin') { %><a class="menu-item" role="menuitem" href="/dashboard"><span class="menu-text"><%= t('nav.admin') %></span></a><% } %>
            <form method="post" action="/logout" class="menu-sep"><input type="hidden" name="_csrf" value="<%= csrfFor() %>"><button class="menu-item" type="submit" role="menuitem"><span class="menu-text"><%= t('nav.logout') %></span></button></form>
          </div>
        </details>
      <% } else { %>
        <a class="btn discord" href="/auth/discord?next=<%= encodeURIComponent(currentPath) %>">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          <span class="discord-label"><%= t('auth.discord.button') %></span>
        </a>
      <% } %>
    </div>
  </div>
</header>
