# --- Discord (portail développeur : https://discord.com/developers/applications) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Serveur PS4Store ---
PS4STORE_API_URL=http://127.0.0.1:3000
# Doit être IDENTIQUE à BOT_API_SECRET dans server/.env (8 caractères minimum, aléatoire)
BOT_API_SECRET=
# Adresse publique du site (liens des boutons). Vide : PUBLIC_URL du serveur est utilisée.
PS4STORE_PUBLIC_URL=

# --- Salons (ID) : peuvent aussi être définis depuis Discord avec /setup (config.json l'emporte) ---
WELCOME_CHANNEL_ID=
RULES_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
BOOST_CHANNEL_ID=
TICKETS_CHANNEL_ID=
CHANGELOGS_CHANNEL_ID=
WEBSITE_CHANNEL_ID=
POLLS_CHANNEL_ID=
ADDITIONS_CHANNEL_ID=
CMD_CHANNEL_ID=
REPORT_CHANNEL_ID=
STAFF_LOGS_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
AUTO_ROLE_ID=

# --- Staff ---
# Rôles Staff (IDs séparés par des virgules) : accès aux tickets et aux commandes publiques hors du salon cmd
STAFF_ROLE_IDS=
# Catégorie Discord où créer les tickets (ID). Vide : catégorie du salon de logs Staff.
STAFF_CATEGORY_ID=
# Rôle pingé par défaut par /annonce
ANNOUNCE_ROLE_ID=
